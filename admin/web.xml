<web-app>
    <servlet>
        <servlet-name>
            _nusuth_file_servlet
        </servlet-name>
        <servlet-class>
            com.azoft.nusuth.core.FileServlet
        </servlet-class>
        <init-param>
          <param-name>
            check-interval
          </param-name>
          <param-value>
            15
          </param-value>
        </init-param>
        <init-param>
          <param-name>
            cache-size
          </param-name>
          <param-value>
            1Mb
          </param-value>
        </init-param>
    </servlet>
    <servlet>
        <servlet-name>
            _nusuth_dir_servlet
        </servlet-name>
        <jsp-file>
            com.azoft.nusuth.core.DirServlet
        </jsp-file>
<!--
        <load-on-startup>
          1
        </load-on-startup>
-->
    </servlet>
    <servlet>
        <servlet-name>
            _nusuth_jsp_servlet
        </servlet-name>
        <servlet-class>
            com.azoft.nusuth.jsp.NusuthJspServlet
        </servlet-class>
    </servlet>
    <servlet>
        <servlet-name>
            _nusuth_error_servlet
        </servlet-name>
        <servlet-class>
            com.azoft.nusuth.core.ErrorServlet
        </servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>
            _nusuth_jsp_servlet
        </servlet-name>
        <url-pattern>
            *.jsp
        </url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>
            _nusuth_file_servlet
        </servlet-name>
        <url-pattern>
            /
        </url-pattern>
    </servlet-mapping>

