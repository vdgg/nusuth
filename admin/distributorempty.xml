<?xml version="1.0" encoding="ISO-8859-1"?>
<!DOCTYPE distributor SYSTEM "../admin/distributor.dtd">
<distributor>
   <name/>
   <connection-factory>
      <class-name/>
      <init-parameter>
         <name/>
         <value/>
      </init-parameter>
   </connection-factory>
   <protocol-adapter/>
   <manager>
      <port/>
      <auth-key/>
   </manager>
   <logger>
      <level/>
      <location/>
      <config/>
   </logger>
   <tcp-server>
      <port/>
      <queue/>
      <min-handlers/>
      <max-handlers/>
      <max-keepalives/>
      <so-timeout/>
      <handler-timeout/>
      <allow-hosts/>
      <deny-hosts/>
   </tcp-server>
   <ssl-server>
      <port/>
      <queue/>
      <min-handlers/>
      <max-handlers/>
      <max-keepalives/>
      <so-timeout/>
      <handler-timeout/>
      <allow-hosts/>
      <deny-hosts/>
      <keystore>
         <location/>
         <password/>
      </keystore>
      <is-client-authentication-needed/>
      <trustedstore>
         <location/>
         <password/>
      </trustedstore>
   </ssl-server>
   <cache>
      <location/>
      <max-used-memory-size/>
      <max-used-disk-size/>
      <max-page-size/>
      <min-refresh-time/>
   </cache>
   <container-info>
      <name/>
      <container-host/>
      <port/>
      <admin-port/>
   </container-info>
   <host>
      <id/>
      <context>
         <url/>
         <protocol/>
         <container/>
      </context>
   </host>
</distributor>
